/* Permission prompts. Keep the keys in sync with Info.plist and tr.lproj/InfoPlist.strings. */

"NSCameraUsageDescription" = "Starboard uses the camera to scan the barcodes of packaged foods. Only the barcode number is sent to Open Food Facts to find the nutrition facts; no image is saved or sent.";

"NSHealthShareUsageDescription" = "Starboard reads your steps, sleep and weight from Apple Health to show them with your daily goals. Starboard does not send this data anywhere.";

"NSHealthUpdateUsageDescription" = "Starboard does not write any data to Apple Health. It only reads your steps, sleep and weight.";

"NSMicrophoneUsageDescription" = "Starboard uses the microphone to convert speech to text on your device only. Audio is not recorded, saved, or sent anywhere.";

"NSSpeechRecognitionUsageDescription" = "Starboard converts speech to text entirely on your device. Speech is not saved or sent anywhere.";
